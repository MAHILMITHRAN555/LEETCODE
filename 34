/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* searchRange(int* nums, int numsSize, int target, int* returnSize) {
    int n=numsSize;
    int t=target;
    int *arr=malloc(2*sizeof(int));
    *returnSize=2;
    arr[0]=-1;
    arr[1]=-1;
    
   int l=0;
   int h=n-1;
   while(l<=h)
   {
    int mid=(l+h)/2;
    if(nums[mid]==t)
    {
        arr[0]=mid;
        h=mid-1;

    }
    else if(nums[mid]<t)
     {
         l=mid+1;
     }
     else
     {
        h=mid-1;
     }
   }
   l=0;
   h=n-1;
   while(l<=h)
   {
    int mid=(l+h)/2;
    if(nums[mid]==t)
    {
        arr[1]=mid;
        l=mid+1;

    }
    else if(nums[mid]<t)
     {
         l=mid+1;
     }
     else
     {
        h=mid-1;
     }
   }
   return arr;  
}
