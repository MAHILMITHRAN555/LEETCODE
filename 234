USING ARRAY:

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
bool isPalindrome(struct ListNode* head) {
     struct ListNode*next;
     struct ListNode*temp=head;
     struct ListNode*current=head;
     struct ListNode*prev=NULL;
     int c=0;
     while(temp!=NULL)
    { 
        c++;
        temp=temp->next;
      
    }
    int a1[c];
    int a2[c];
    temp=head;
    int i=0;
    while(temp!=NULL)
    {
          a1[i]=temp->val;
          temp=temp->next;
          i++;
    }
     while(current!=NULL)
     {
              next=current->next;
              current->next=prev;
              prev=current;
              current=next;
     }
     int j=0;
     while(prev!=NULL)
     {
          a2[j]=prev->val;
          prev=prev->next;
          j++;
     }
   for(int i=0;i<c;i++)
   { 
        if(a1[i]!=a2[i])
        { 
         return false;
        }
   }
     return true;
    
}

